# せーの！神輿バトル — 環境変数の一覧（すべて任意。未設定でもニックネーム参加で遊べる）
# 本番は Render のダッシュボード → Environment に入れる。このリポジトリは公開なので実際の値を書かないこと。

# PORT=3000
# DATA_DIR=./data

# Googleログイン（設定するとボタンが出る）
GOOGLE_CLIENT_ID=

# 外部連携API・試合結果Webhook
API_KEY=
WEBHOOK_URL=
WEBHOOK_SECRET=

# forcommunity でログイン（4つすべて設定したときだけ有効）
FORCOMMUNITY_ISSUER=https://did-event.vercel.app
FORCOMMUNITY_CLIENT_ID=mikoshi-battle
FORCOMMUNITY_CLIENT_SECRET=
# 本番: https://mikoshi-battle.onrender.com/auth/forcommunity/callback
FORCOMMUNITY_REDIRECT_URI=http://localhost:3000/auth/forcommunity/callback
